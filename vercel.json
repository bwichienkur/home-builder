{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/buildertrend/refresh.js": {
      "maxDuration": 60
    },
    "api/buildertrend/ping.js": {
      "maxDuration": 10
    },
    "api/ops.js": {
      "maxDuration": 30
    },
    "api/org-config.js": {
      "maxDuration": 30
    },
    "api/trade-rates.js": {
      "maxDuration": 30
    },
    "api/crm.js": {
      "maxDuration": 30
    },
    "api/auth-admin.js": {
      "maxDuration": 30
    },
    "api/auth/login.js": {
      "maxDuration": 30
    },
    "api/auth/register.js": {
      "maxDuration": 30
    },
    "api/auth/logout.js": {
      "maxDuration": 30
    },
    "api/auth/me.js": {
      "maxDuration": 30
    },
    "api/designs.js": {
      "maxDuration": 30
    },
    "api/drawing-packages.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/api/admin/:path*", "destination": "/api/auth-admin?__admin=1&__path=:path*" },
    { "source": "/api/crm/:collection", "destination": "/api/crm?collection=:collection" },
    { "source": "/api/designs/:code", "destination": "/api/designs?__code=:code" },
    { "source": "/api/drawing-packages/:id", "destination": "/api/drawing-packages?__id=:id" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
