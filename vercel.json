{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/buildertrend/refresh.js": {
      "maxDuration": 300
    },
    "api/pipedrive/refresh.js": {
      "maxDuration": 60
    },
    "api/pipedrive/dashboard.js": {
      "maxDuration": 30
    },
    "api/buildertrend/dashboard.js": {
      "maxDuration": 30
    },
    "api/ops.js": {
      "maxDuration": 30
    },
    "api/org-config.js": {
      "maxDuration": 30
    },
    "api/trade-rates.js": {
      "maxDuration": 30
    },
    "api/crm.js": {
      "maxDuration": 30
    },
    "api/auth.js": {
      "maxDuration": 30
    },
    "api/designs.js": {
      "maxDuration": 30
    },
    "api/drawing-packages.js": {
      "maxDuration": 60
    },
    "api/takeoff.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/api/auth/:path*", "destination": "/api/auth?__path=:path*" },
    { "source": "/api/admin/:path*", "destination": "/api/auth?__admin=1&__path=:path*" },
    { "source": "/api/users", "destination": "/api/auth?__users=1&__path=users" },
    { "source": "/api/crm/:collection", "destination": "/api/crm?collection=:collection" },
    { "source": "/api/designs/:code", "destination": "/api/designs?__code=:code" },
    { "source": "/api/drawing-packages/:id", "destination": "/api/drawing-packages?__id=:id" },
    { "source": "/api/takeoff/ai", "destination": "/api/takeoff?__path=ai" },
    { "source": "/api/takeoff/project", "destination": "/api/takeoff?__path=project" },
    { "source": "/api/buildertrend/ping", "destination": "/api/buildertrend/dashboard?__ping=1" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
