DATABASE_URL=postgres://roomcraft:roomcraft@localhost:5432/roomcraft
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
ASSET_CDN_URL=https://cdn.example.com/models
# In production, validate a JWT from your identity provider instead of DEV_USER_ID.
DEV_USER_ID=00000000-0000-0000-0000-000000000001

# --- Frontend platform switches ($0 defaults) ---
# local = browser auth (default, $0). remote = call /api/auth (or later Auth0/Clerk).
VITE_AUTH_PROVIDER=local
# local = browser CRM (default, $0). http = sync via VITE_API_URL /api/crm.
VITE_CRM_PROVIDER=local
# Required only when AUTH=remote or CRM=http
# VITE_API_URL=http://localhost:4000
# VITE_DEV_USER_ID=00000000-0000-0000-0000-000000000001
# Owner dashboard data: snapshot (default, 19 Aug 2026 read-only BT capture), mock, or api (partner client — not wired).
# Never store Buildertrend passwords in the repo.
# VITE_BUILDERTREND_PROVIDER=snapshot
#
# Read-only refresh button (POST /api/buildertrend/refresh via `npm run server` or Vercel /api).
# Website login is Auth0 + reCAPTCHA, so unattended website pulls need BUILDERTREND_COOKIE from a
# logged-in browser. The mobile app AjaxLogin is tried next. Only GET reports after login.
# Never commit these values.
# BUILDERTREND_USERNAME=you@example.com
# BUILDERTREND_PASSWORD=
# BUILDERTREND_COOKIE=
#
# Pipedrive (read-only sales funnel). Token from Settings → Personal preferences → API.
# Never commit these values.
# PIPEDRIVE_API_TOKEN=
# PIPEDRIVE_COMPANY_DOMAIN=olsencustom
